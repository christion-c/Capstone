# typescript-eslint's peerDependency range for "typescript" (>=4.8.4 <6.1.0)
# doesn't yet cover this project's TypeScript 7.x (the new Go-based native
# compiler) - see scripts/setup-lint-typescript-shim.mjs for the full story.
# Without this, a plain `npm install`/`npm ci` fails with ERESOLVE.
legacy-peer-deps=true
