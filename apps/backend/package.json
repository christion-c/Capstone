{
  "name": "@thinktwice/backend",
  "version": "0.1.0",
  "description": "ThinkTwice back-end API",
  "private": true,
  "type": "module",
  "prettier": "../../.prettierrc.json",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "postinstall": "node scripts/setup-lint-typescript-shim.mjs",
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "bash -c \"shopt -s globstar; export DATABASE_URL=\\${DATABASE_URL:-postgresql://thinktwice:thinktwice_dev@localhost:5433/thinktwice}; export INTERNAL_SERVICE_TOKEN=\\${INTERNAL_SERVICE_TOKEN:-test-only-internal-token}; export CORS_ORIGIN=\\${CORS_ORIGIN:-*}; tsx --test --experimental-test-module-mocks src/**/*.test.ts\""
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^14.2.0",
    "google-auth-library": "10.9.1",
    "helmet": "^8.1.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.20.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0"
  }
}
